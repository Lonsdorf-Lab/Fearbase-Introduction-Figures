### File generated by `rix::rix_init()` ###
# Keep Nix sessions isolated from packages installed in the host user library.
{
  is_rstudio <- Sys.getenv("RSTUDIO") == "1"
  is_nix_r <- nzchar(Sys.getenv("NIX_STORE"))
  is_code <- Sys.getenv("TERM_PROGRAM") == "vscode"
  is_positron <- Sys.getenv("POSITRON") == "1"

  if (isFALSE(is_nix_r) && isTRUE(is_rstudio)) {
    old_path <- Sys.getenv("PATH")
    nix_path <- getOption(
      "rix.nix_bin",
      "/nix/var/nix/profiles/default/bin"
    )

    if (isFALSE(any(grepl(nix_path, old_path, fixed = TRUE)))) {
      Sys.setenv(PATH = paste(old_path, nix_path, sep = ":"))
    }

    rm(old_path, nix_path)
  }

  if (isTRUE(is_nix_r)) {
    install.packages <- function(...) {
      stop(
        "This R session is managed by Nix. Add packages to generate_env.R ",
        "and regenerate default.nix instead of calling install.packages()."
      )
    }

    update.packages <- function(...) {
      stop(
        "This R session is managed by Nix. Update the pinned rix snapshot ",
        "instead of calling update.packages()."
      )
    }

    remove.packages <- function(...) {
      stop(
        "This R session is managed by Nix. Remove packages from ",
        "generate_env.R instead of calling remove.packages()."
      )
    }

    current_paths <- .libPaths()
    user_library <- Sys.getenv("R_LIBS_USER")

    if (nzchar(user_library)) {
      .libPaths(current_paths[current_paths != user_library])
    }

    rm(current_paths, user_library)
  }

  if (
    isTRUE(is_code) &&
      interactive() &&
      isFALSE(is_rstudio) &&
      isFALSE(is_positron)
  ) {
    vscode_r_init <- file.path(
      Sys.getenv(if (.Platform$OS.type == "windows") "USERPROFILE" else "HOME"),
      ".vscode-R",
      "init.R"
    )

    if (file.exists(vscode_r_init)) {
      source(vscode_r_init)
    }

    rm(vscode_r_init)
  }

  rm(is_rstudio, is_nix_r, is_code, is_positron)
}

